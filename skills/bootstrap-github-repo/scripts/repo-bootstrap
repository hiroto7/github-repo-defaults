#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
skill_dir=$(cd "$script_dir/.." && pwd)

usage() {
  cat <<'EOF'
Usage: repo-bootstrap OWNER/REPO --profile PROFILE [--apply]

Profiles:
  python
  python-macos
  node-web
  tooling

The default is a read-only plan. Pass --apply to change repository settings
and create or update the managed rulesets.
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

repo_name=""
profile=""
apply=false

while (($# > 0)); do
  case "$1" in
    --profile)
      (($# >= 2)) || die "--profile requires a value"
      profile=$2
      shift 2
      ;;
    --apply)
      apply=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      die "unknown option: $1"
      ;;
    *)
      [[ -z "$repo_name" ]] || die "only one OWNER/REPO argument is allowed"
      repo_name=$1
      shift
      ;;
  esac
done

[[ "$repo_name" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || \
  die "repository must be written as OWNER/REPO"

case "$profile" in
  python|python-macos|node-web|tooling) ;;
  "") die "--profile is required" ;;
  *) die "unknown profile: $profile" ;;
esac

ruleset_files=("$skill_dir/assets/rulesets/main-$profile.json")
if [[ "$profile" == "python-macos" ]]; then
  ruleset_files+=("$skill_dir/assets/rulesets/tags-python-macos.json")
fi

for ruleset_file in "${ruleset_files[@]}"; do
  [[ -f "$ruleset_file" ]] || die "missing ruleset: $ruleset_file"
done

print_plan() {
  echo "Repository: $repo_name"
  echo "Profile:    $profile"
  echo "Mode:       $([[ "$apply" == true ]] && echo apply || echo dry-run)"
  echo
  echo "Repository settings:"
  echo "  squash merge:          enabled"
  echo "  merge commits:         disabled"
  echo "  rebase merge:          disabled"
  echo "  delete branch on merge: enabled"
  echo
  echo "Managed rulesets:"
  for ruleset_file in "${ruleset_files[@]}"; do
    jq -r '"  \(.name) [\(.target)]: " + ([.rules[] | if .type == "required_status_checks" then (.parameters.required_status_checks | map(.context) | join(", ")) else empty end] | if length == 0 then "no status checks" else join(", ") end)' "$ruleset_file"
  done
  echo
  echo "Starter files: $skill_dir/assets/templates/$profile/.github"
  if [[ "$profile" == "node-web" ]]; then
    echo "Starter scripts: $skill_dir/assets/templates/node-web/scripts"
  fi
}

print_plan

if [[ "$apply" != true ]]; then
  echo
  echo "No changes made. Re-run with --apply to update GitHub."
  exit 0
fi

command -v gh >/dev/null 2>&1 || die "gh is required"
command -v jq >/dev/null 2>&1 || die "jq is required"

gh auth status >/dev/null
gh repo view "$repo_name" --json nameWithOwner,defaultBranchRef >/dev/null

echo
echo "Updating repository merge settings..."
gh api --method PATCH "repos/$repo_name" \
  -F allow_squash_merge=true \
  -F allow_merge_commit=false \
  -F allow_rebase_merge=false \
  -F delete_branch_on_merge=true >/dev/null

for ruleset_file in "${ruleset_files[@]}"; do
  ruleset_name=$(jq -r '.name' "$ruleset_file")
  ruleset_target=$(jq -r '.target' "$ruleset_file")
  ruleset_id=$(gh api "repos/$repo_name/rulesets" \
    --jq ".[] | select(.name == \"$ruleset_name\" and .target == \"$ruleset_target\") | .id" | head -n 1)

  if [[ -n "$ruleset_id" ]]; then
    echo "Updating ruleset: $ruleset_name ($ruleset_id)"
    gh api --method PUT "repos/$repo_name/rulesets/$ruleset_id" \
      --input "$ruleset_file" >/dev/null
  else
    echo "Creating ruleset: $ruleset_name"
    gh api --method POST "repos/$repo_name/rulesets" \
      --input "$ruleset_file" >/dev/null
  fi
done

echo "Done. Verify the repository's Rules and Actions settings in GitHub."
